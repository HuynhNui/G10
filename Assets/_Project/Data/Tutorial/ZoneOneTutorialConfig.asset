  m_Script: {fileID: 11500000, guid: dd8f9b4e4918f934a812c7043ef8b820, type: 3}
  m_Name: ZoneOneTutorialConfig
  m_EditorClassIdentifier: G10.Prototype::G10.Prototype.Tutorial.TutorialConfig
  guideDisplayName: AI
  movementDistance: 20
  headingDelta: 15
  depthDelta: 5
  pollInterval: 0.15
